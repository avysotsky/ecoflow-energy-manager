ECOFLOW_POSTGRES_CONNECTION=Host=/var/run/postgresql;Database=ecoflow_energy;Username=user
ECOFLOW_WEB_URLS=http://127.0.0.1:5095
ECOFLOW_SETTINGS_PATH=/home/user/.local/share/ecoflow-energy-manager/settings.json
ECOFLOW_CONTROL_ENABLED=false
ECOFLOW_CONTROL_MIN_BACKUP_RESERVE=20
ECOFLOW_CONTROL_MAX_BACKUP_RESERVE=100
ECOFLOW_CONTROL_MIN_INTERVAL_MINUTES=60
ECOFLOW_MANUAL_OVERRIDE_FILE=/home/user/.local/share/ecoflow-energy-manager/manual-override
ECOFLOW_CONTROL_STATE_PATH=/home/user/.local/share/ecoflow-energy-manager/control-state.json
ECOFLOW_TELEGRAM_COMMAND=
ECOFLOW_TELEGRAM_TIMEOUT_SECONDS=120
